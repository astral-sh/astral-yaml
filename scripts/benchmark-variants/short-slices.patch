+#[inline]
+fn find_either(bytes: &[u8], first: u8, second: u8) -> Option<usize> {
+    if bytes.len() < 16 {
+        bytes.iter().position(|&byte| byte == first || byte == second)
+    } else {
+        memchr::memchr2(first, second, bytes)
+    }
+}
