-MAP
=VAL :run
=VAL |shopt -s failglob\npushd dist\nshasum -a 256 gh_* > checksums.txt\nmv checksums.txt gh_${TAG_NAME#v}_checksums.txt\npopd\nrelease_args=(\n  "$TAG_NAME"\n  --title "GitHub CLI ${TAG_NAME#v}"\n  --target "$GITHUB_SHA"\n  --generate-notes\n)\nif [[ $TAG_NAME == *-* ]]; then\n  release_args+=( --prerelease )\nfi\nguard="echo"\n[ "$DO_PUBLISH" = "false" ] || guard=""\nscript/label-assets dist/gh_* | xargs $guard gh release create "${release_args[@]}" --\n
-MAP
+MAP
=VAL :name
=VAL :Publish site
=VAL :if
=VAL :${{ inputs.environment == 'production' }}
=VAL :env
+MAP
=VAL :DO_PUBLISH
=VAL :${{ inputs.environment == 'production' && !contains(inputs.tag_name, '-') && !inputs.dry_run }}
=VAL :TAG_NAME
=VAL :${{ inputs.tag_name }}
=VAL :GIT_COMMITTER_NAME
=VAL :cli automation
=VAL :GIT_AUTHOR_NAME
=VAL :cli automation
=VAL :GIT_COMMITTER_EMAIL
=VAL :noreply@github.com
=VAL :GIT_AUTHOR_EMAIL
=VAL :noreply@github.com
-MAP
=VAL :working-directory
=VAL :./site
=VAL :run
=VAL |git add packages\ngit commit -m "Add rpm and deb packages for $TAG_NAME"\nif [ "$DO_PUBLISH" = "true" ]; then\n  git push\nelse\n  git log --oneline @{upstream}..\n  git diff --name-status @{upstream}..\nfi\n
-MAP
-SEQ
-MAP
-MAP
-MAP
-DOC
-STR
