-MAP
-MAP
+MAP
=VAL :name
=VAL "Load GitLab OIDC tokens from GitLab job artifacts
=VAL :id
=VAL :load-gitlab-oidc-token
=VAL :run
=VAL |# we expect ./gitlab-artifacts/*/artifacts/pypi-id-token to exist\npypi_id_token_file=$(find ./gitlab-artifacts -type f -name pypi-id-token | head -n 1)\nif [ -z "${pypi_id_token_file}" ]; then\n  echo "No pypi-id-token file found in GitLab artifacts"\n  exit 1\nfi\nGITLAB_PYPI_OIDC_TOKEN=$(cat "${pypi_id_token_file}")\n\n# Add secret masks for the tokens.\necho "::add-mask::$GITLAB_PYPI_OIDC_TOKEN"\n\necho "GITLAB_PYPI_OIDC_TOKEN=${GITLAB_PYPI_OIDC_TOKEN}" >> "${GITHUB_OUTPUT}"\n
-MAP
+MAP
=VAL :name
=VAL "Add password to uv text store
=VAL :run
=VAL |./uv auth login https://test.pypi.org/legacy/?astral-test-text-store --token ${UV_TEST_PUBLISH_TEXT_STORE}\n
=VAL :env
+MAP
=VAL :UV_TEST_PUBLISH_TEXT_STORE
=VAL :${{ secrets.UV_TEST_PUBLISH_TEXT_STORE }}
-MAP
-MAP
+MAP
=VAL :name
