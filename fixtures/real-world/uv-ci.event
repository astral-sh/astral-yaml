=VAL :${{ secrets.UV_TEST_PUBLISH_PASSWORD }}
=VAL :UV_TEST_PUBLISH_KEYRING
=VAL :${{ secrets.UV_TEST_PUBLISH_KEYRING }}
=VAL :UV_TEST_PUBLISH_GITLAB_PAT
=VAL :${{ secrets.UV_TEST_PUBLISH_GITLAB_PAT }}
=VAL :UV_TEST_PUBLISH_CODEBERG_TOKEN
=VAL :${{ secrets.UV_TEST_PUBLISH_CODEBERG_TOKEN }}
=VAL :UV_TEST_PUBLISH_CLOUDSMITH_TOKEN
=VAL :${{ secrets.UV_TEST_PUBLISH_CLOUDSMITH_TOKEN }}
