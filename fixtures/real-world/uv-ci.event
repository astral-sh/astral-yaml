=VAL :runs-on
=VAL :${{ github.repository_owner == 'astral-sh' && 'github-ubuntu-24.04-x86_64-2' || 'ubuntu-slim' }}
=VAL :steps
+SEQ
+MAP
=VAL :name
=VAL "Check required jobs passed
=VAL :run
=VAL |failing=$(\n  echo "$NEEDS_JSON" | jq -r --argjson conditional_jobs "$CONDITIONAL_JOBS" '\n    to_entries[]\n    | select($conditional_jobs[.key] != false)\n    | select(.value.result != "success" and .value.result != "skipped")\n    | "\\(.key): \\(.value.result)"\n  '\n)\nif [ -n "$failing" ]; then\n  echo "$failing"\n  exit 1\nfi\n
=VAL :env
+MAP
=VAL :NEEDS_JSON
=VAL :${{ toJSON(needs) }}
=VAL :CONDITIONAL_JOBS
=VAL >{\n  "test-system": ${{ contains(github.event.pull_request.labels.*.name, 'test:system') }}\n}
