=VAL :name
=VAL "Configure apt mirror fallback
=VAL :if
=VAL :matrix.mode == 'simulation'
=VAL :run
=VAL |# Let CodSpeed's dependency installation move past unhealthy mirrors quickly.\ncat /etc/apt/apt-mirrors.txt\nprintf '%s\\n' \\\n  'Acquire::Retries "0";' \\\n  'Acquire::http::Timeout "10";' \\\n  'Acquire::https::Timeout "10";' \\\n  | sudo tee /etc/apt/apt.conf.d/80-retries > /dev/null\n
