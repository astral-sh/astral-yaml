=VAL :check-generated-files
=VAL :check-c-api-docs
=VAL :build-windows
=VAL :build-macos
=VAL :build-ubuntu
=VAL :build-ubuntu-installed
=VAL :build-ubuntu-ssltests
=VAL :build-ios
=VAL :build-emscripten
=VAL :build-wasi
