=VAL :if
=VAL :startsWith(github.ref, 'refs/heads/releases/') || github.ref == 'refs/heads/main'
=VAL :runs-on
=VAL :ubuntu-latest
=VAL :steps
+SEQ
+MAP
=VAL :uses
=VAL :actions/checkout@v7
-MAP
+MAP
=VAL :name
=VAL :Check version
=VAL :uses
=VAL :actions/github-script@v9
=VAL :with
+MAP
=VAL :github-token
=VAL :${{secrets.GITHUB_TOKEN}}
=VAL :script
=VAL |const fs = require('fs');\nconst runnerVersion = fs.readFileSync('${{ github.workspace }}/src/runnerversion', 'utf8').replace(/\\n$/g, '')\nconst releaseVersion = fs.readFileSync('${{ github.workspace }}/releaseVersion', 'utf8').replace(/\\n$/g, '')\nif (runnerVersion != releaseVersion) {\n  console.log('Request Release Version: ' + releaseVersion + '\\nCurrent Runner Version: ' + runnerVersion)\n  core.setFailed('Version mismatch! Make sure ./releaseVersion match ./src/runnerVersion')\n  return\n}\ntry {\n  const release = await github.rest.repos.getReleaseByTag({\n    owner: '${{ github.event.repository.owner.name }}',\n    repo: '${{ github.event.repository.name }}',\n    tag: 'v' + runnerVersion\n  })\n  core.setFailed('Release with same tag already created: ' + release.data.html_url)\n} catch (e) {\n  // We are good to create the release if release with same tag doesn't exists\n  if (e.status != 404) {\n    throw e\n  }\n}\n
