from typing import Any, Protocol

class _Reader(Protocol):
    def read(self, size: int, /) -> str | bytes | bytearray: ...

class _Writer(Protocol):
    def write(self, text: str, /) -> object: ...

class YAMLError(ValueError): ...

# The document determines the types of the returned values, as in json.loads.
def loads(data: str | bytes | bytearray) -> Any: ...  # noqa: ANN401
def load(fp: _Reader) -> Any: ...  # noqa: ANN401
def dumps(obj: object) -> str: ...
def dump(obj: object, fp: _Writer) -> None: ...
